# Used by docker-compose.yml. Copy to .env (gitignored) and fill in.
DB_PASSWORD=change-me
# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# "prod" for a clean database. "dev" also seeds demo employers, jobs and accounts.
SPRING_PROFILES_ACTIVE=dev

# Optional: first admin account, created on first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true when serving over HTTPS.
AUTH_COOKIE_SECURE=false
