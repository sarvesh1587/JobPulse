# Copy this file to .env and fill in real values locally.
# Never commit the actual .env file.

DB_URL=jdbc:postgresql://localhost:5432/jobpulse
DB_USERNAME=jobpulse
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SERVER_PORT=8080

# Generate a long random string for this — e.g. `openssl rand -base64 64`
JWT_SECRET=change-me-to-a-long-random-secret

CORS_ALLOWED_ORIGINS=http://localhost:5173

RESUME_STORAGE_DIR=./data/resumes
RESUME_MAX_SIZE_MB=5
RESUME_MAX_SIZE_BYTES=5242880
