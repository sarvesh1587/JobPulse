# Local development settings for running the backend outside Docker.
# Copy to backend/.env (gitignored). Spring Boot loads it automatically
# through spring.config.import, so there's no need to export anything.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/jobpulse
DB_USERNAME=jobpulse
DB_PASSWORD=change-me

# --- Auth ---
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
AUTH_TOKEN_TTL=12h
# false only for local http://localhost. Keep true anywhere with HTTPS.
AUTH_COOKIE_SECURE=false

# --- First admin account (created once, on startup, if no admin exists) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Misc ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
RESUME_STORAGE_DIR=./data/resumes
RESUME_MAX_SIZE_MB=5

# Demo accounts created by the dev profile's seeder (local only)
DEV_SEED_PASSWORD=jobpulse-demo

# Ingestion from public ATS boards (off by default, targets go in application.yml)
INGESTION_ENABLED=false
