# Copy to frontend/.env.local (gitignored) if you need to change these.

# Base path or URL the SPA calls. Leave it as /api when the frontend and
# backend share an origin (Vite proxy in dev, nginx in Docker). That keeps
# the auth cookie first-party and avoids CORS.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY=http://localhost:8080
